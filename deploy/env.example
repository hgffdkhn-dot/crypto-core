# 复制为 .env 后填写。切勿提交到仓库。
#
#   cp deploy/env.example deploy/.env
#   openssl rand -base64 32      # → DB_PASSWORD / PEPPER_B64 各生成一次

# PostgreSQL 口令
DB_PASSWORD=change-me-db-password

# Argon2id pepper（口令哈希的额外密钥，服务端外挂）
# ⚠️ 上线后改动 = 所有已注册用户无法登录，只能重置口令
PEPPER_B64=

# 对外访问地址（客户端默认服务器地址、头像 URL 拼接用）
PUBLIC_BASE_URL=https://chat.example.com
