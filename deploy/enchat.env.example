# systemd 使用的环境变量文件。放到 /etc/enchat/enchat.env，权限 600，属主 enchat。
#
#   sudo install -o enchat -g enchat -m 600 deploy/enchat.env /etc/enchat/enchat.env

ENCHAT_HOST=127.0.0.1
ENCHAT_PORT=8080

ENCHAT_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/enchat
ENCHAT_DB_USER=enchat
ENCHAT_DB_PASSWORD=change-me-db-password
ENCHAT_DB_POOL=8

# ⚠️ 上线后绝不可更改：改了所有老用户都无法登录
ENCHAT_PEPPER_B64=CHANGE_ME_openssl_rand_base64_32

# 服务器长期身份密钥。必须持久化并备份；丢失/重建 = 已装客户端全部连不上
ENCHAT_SERVER_KEY_FILE=/var/lib/enchat/keys/server-identity.key
ENCHAT_UPLOAD_DIR=/var/lib/enchat/uploads

ENCHAT_PUBLIC_BASE_URL=https://chat.example.com
ENCHAT_E2EE_RETENTION_DAYS=30

JAVA_OPTS=-Xms512m -Xmx1500m -XX:+UseG1GC -Dfile.encoding=UTF-8
